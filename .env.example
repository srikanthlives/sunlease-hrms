# Application Settings
HRMS_SECRET_KEY=dev-secret-change-in-production-please
HRMS_APP_NAME=HRMS — Employee Data Management
HRMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# For local SQLite: sqlite:///../data/hrms.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
HRMS_DATABASE_URL=sqlite:///../data/hrms.db

# Upload storage (documents/photos/attachments) - "local" (default) or "r2"
# (Cloudflare R2, S3-compatible - see backend/app/services/storage.py).
HRMS_STORAGE_TYPE=local
HRMS_UPLOAD_DIR=../data/uploads

# Only needed when HRMS_STORAGE_TYPE=r2:
# HRMS_R2_ACCOUNT_ID=your-cloudflare-account-id
# HRMS_R2_ACCESS_KEY_ID=your-r2-access-key-id
# HRMS_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# HRMS_R2_BUCKET_NAME=hrms-attachments
# HRMS_R2_ENDPOINT_URL=   # optional override; defaults to https://<account_id>.r2.cloudflarestorage.com
# HRMS_R2_PREFIX=HRMS     # optional root folder inside the bucket

# JWT Token Settings
HRMS_ALGORITHM=HS256
HRMS_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Outbound email (backend/app/services/email_service.py) - two transports:
#
# Option A: direct SMTP (works for local/bare-metal dev, or any host that
# doesn't block outbound SMTP). Leave HRMS_MAIL_RELAY_URL unset to use this.
HRMS_SMTP_HOST=
HRMS_SMTP_PORT=587
HRMS_SMTP_USERNAME=
HRMS_SMTP_PASSWORD=
HRMS_SMTP_USE_SSL=false
HRMS_SMTP_FROM_EMAIL=
HRMS_SMTP_FROM_NAME=HRMS — Employee Data Management
#
# Option B: HTTP mail relay - required on platforms that block outbound
# SMTP (confirmed on Railway). Deploy backend/scripts/cpanel-mail-relay.php
# to the same cPanel server as the mailbox (see that file's SETUP comment),
# then set these two - this switches the backend to use the relay
# automatically, no other config needed:
HRMS_MAIL_RELAY_URL=
HRMS_MAIL_RELAY_SECRET=

HRMS_STORAGE_TYPE=r2
HRMS_R2_ACCOUNT_ID=
HRMS_R2_ACCESS_KEY_ID=
HRMS_R2_SECRET_ACCESS_KEY=
HRMS_R2_BUCKET_NAME=